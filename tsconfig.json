{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build-*/types/**/*.ts",
    ".next-build-*/dev/types/**/*.ts",
    ".next-build-2026-06-01T07-22-50-435Z/types/**/*.ts",
    ".next-build-2026-06-01T07-22-50-435Z/dev/types/**/*.ts",
    ".next-build-2026-06-01T07-24-36-633Z/types/**/*.ts",
    ".next-build-2026-06-01T07-24-36-633Z/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
